# ==============================================================================
# Infrastructure configuration: TimescaleDB, Mosquitto, and InfluxDB.
# DAQ Navi and Portal have their own files under deploy/.
# ==============================================================================

# ─── TimescaleDB (PostgreSQL 16) ──────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=daq_db
DB_PORT=5432


# ─── InfluxDB 2.x ─────────────────────────────────────────────────────────────
INFLUX_PORT=8086
INFLUX_USERNAME=admin
INFLUX_PASSWORD=adminpassword123
INFLUX_ORG=mddp
INFLUX_BUCKET=daq_telemetry
INFLUX_TOKEN=mddp-super-secret-auth-token
